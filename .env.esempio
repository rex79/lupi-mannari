# Copia questo file in ".env" e completa i valori.

# --- Messa on-line (VPS) ----------------------------------------------------

# Dominio del sito, con DNS puntato al server. Serve a Caddy per l'HTTPS automatico.
# DOMINIO=lupi.example.com

# Indirizzo pubblico completo: è quello che ricevono i giocatori (link e QR).
# In casa lascialo commentato: si usa automaticamente l'IP locale.
# URL_PUBBLICO=https://lupi.example.com

# Quante partite possono vivere in contemporanea sul server.
# MAX_STANZE=100

# --- Voce teatrale (facoltativa) --------------------------------------------

# Voce teatrale del narratore (OpenAI). Senza chiave il tavolo usa la voce del browser.
# Con il narratore "in carne e ossa" la voce non serve.
# La chiave si crea su https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Voce: onyx (profonda, predefinita), ash, ballad, cedar, echo, fable, marin, sage, verse…
# VOCE_NOME=onyx

# Modello di sintesi vocale che accetta le istruzioni di regia.
# VOCE_MODELLO=gpt-4o-mini-tts

# Regia della voce: come deve recitare il narratore (sostituisce quella predefinita in src/voce.js).
# VOCE_ISTRUZIONI=Sei un cantastorie anziano, voce roca e lenta, che racconta vicino al fuoco…

# --- Altre impostazioni ------------------------------------------------------

# PORT=3000
# MIN_GIOCATORI=4
